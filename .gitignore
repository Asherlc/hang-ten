.DS_Store

# Xcode local state and generated output
build/
DerivedData/
xcuserdata/
*.xcuserstate

# Default transient hangboard workspaces
/.context/

# Workbench's local board-library lock
/Hangboards/.workbench.lock

# PyInstaller output for the local workbench release build
/Tools/HangboardWorkbench/packaging/build/
/Tools/HangboardWorkbench/packaging/dist/
/Tools/HangboardWorkbench/packaging/*.spec

# Conductor workspace-local state
.context/

# CodeGraph local index and runtime state
.codegraph/

# Local implementation/git worktrees
.worktrees/

# Developer-specific PostHog project token override
/HangTen/Config/PostHog.local.xcconfig

# Python editable-install and bytecode cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
