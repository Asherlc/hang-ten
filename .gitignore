.DS_Store

# Xcode local state and generated output
build/
DerivedData/
xcuserdata/
*.xcuserstate

# Default transient hangboard workspaces
/.context/
/.superpowers/

# Paseo workspace-local state
.context/

# All current boards are CAD-backed. These files are installed by
# scripts/build-board-assets.sh and are never source inputs.
/Hangboards/*/assets/*.usdz
/Hangboards/*/assets/*.model.json
/Hangboards/*/assets/*.physics.json
/Hangboards/*/assets/suspension.json
/HangTen/Resources/GripHand/hand-mesh.json
/HangTen/Resources/PlanLibrary.json

# CodeGraph local index and runtime state
.codegraph/

# Local implementation/git worktrees
.worktrees/

# Developer-specific analytics API key override
/HangTen/Config/Analytics.local.xcconfig

# Python editable-install and bytecode cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
*.FCBak

# Historical reviews retain findings, screenshots, and authoring evidence.
# Raw execution outputs belong in workspace scratch or CI artifacts.
/docs/**/*.usdz
/docs/**/*.model.json
/docs/**/*.physics.json
/docs/**/*.log
/docs/**/*.stdout
/docs/**/*.stderr
/docs/**/*.swift
/docs/**/*.patch
/docs/**/*.diff
/docs/**/*.xcresult/
/docs/**/*.xcresult.zip
/docs/**/command-logs.zip
# trigger CI

# CAD-backed board packages: board.json is generated from the package's
# <slug>.FCStd (HangTenBoardManifest) at build time and is never committed; the
# package validator rejects an on-disk copy. List each CAD package explicitly
# (a pattern could hide a hand-authored package's board.json).
