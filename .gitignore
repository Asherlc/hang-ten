.DS_Store

# Xcode local state and generated output
build/
DerivedData/
xcuserdata/
*.xcuserstate

# Default transient hangboard workspaces
/.context/
/.superpowers/

# Paseo workspace-local state
.context/

# CodeGraph local index and runtime state
.codegraph/

# Local implementation/git worktrees
.worktrees/

# Developer-specific analytics API key override
/HangTen/Config/Analytics.local.xcconfig

# Python editable-install and bytecode cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
# trigger CI

# CAD-backed board packages: board.json is generated from the package's
# <slug>.FCStd (HangTenBoardManifest) at build time and is never committed; the
# package validator rejects an on-disk copy. List each CAD package explicitly
# (a pattern could hide a hand-authored package's board.json).
