.DS_Store

# Xcode local state and generated output
build/
DerivedData/
xcuserdata/
*.xcuserstate

# Default transient hangboard workspaces
/.context/
/.superpowers/

# Paseo workspace-local state
.context/

# CodeGraph local index and runtime state
.codegraph/

# Local implementation/git worktrees
.worktrees/

# Developer-specific analytics API key override
/HangTen/Config/Analytics.local.xcconfig

# Python editable-install and bytecode cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
# trigger CI

# CAD-backed board packages: board.json is generated from the package's
# <slug>.FCStd (HangTenBoardManifest) at build time and is never committed; the
# package validator rejects an on-disk copy. List each CAD package explicitly
# (a pattern could hide a hand-authored package's board.json).
/Hangboards/soill-iron-palm-2/board.json
/Hangboards/beastmaker-1000/board.json
/Hangboards/beastmaker-2000/board.json
/Hangboards/captain-fingerfood-pocket/board.json
/Hangboards/evolv-kilter-basic-long/board.json
/Hangboards/lattice-mxedge-lift-large/board.json
/Hangboards/lattice-mxedge-lift-small/board.json
/Hangboards/lattice-triple-rung/board.json
/Hangboards/metolius-prime-rib/board.json
/Hangboards/metolius-rock-rings-3d/board.json
/Hangboards/metolius-wood-grips-compact-ii/board.json
/Hangboards/metolius-wood-grips-deluxe-ii/board.json
/Hangboards/j-bryant-ftg-32/board.json
/Hangboards/trango-rock-prodigy-pivot/board.json
