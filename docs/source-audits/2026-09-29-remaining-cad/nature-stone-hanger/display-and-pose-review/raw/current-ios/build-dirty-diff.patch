+        return {"status":"pass","maxNodalResidual":maximum,"activeContacts":[],
+                "requiredNodalReactions":error.tolist(),"nodalResiduals":error.tolist(),
+                "facetReconstructedBalance":facet_reconstructed_balance(mesh,required,[],[]),
