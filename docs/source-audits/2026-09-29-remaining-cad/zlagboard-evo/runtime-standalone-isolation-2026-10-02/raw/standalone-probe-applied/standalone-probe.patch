+            defer { recorder.finishStandaloneObservation() }
+            let phases: [Selection] = [.clear, .active, .preview, .active, .preview]
+            for (index, phase) in phases.enumerated() {
+                let start = baseUptime + Double(index * 8)
+                try await sleepUntil(start)
+                recorder.harnessEvent("standalone-request-\(index)", state: phase.rawValue,
+                                      viewport: viewport)
+                if selection != phase { selection = phase }
