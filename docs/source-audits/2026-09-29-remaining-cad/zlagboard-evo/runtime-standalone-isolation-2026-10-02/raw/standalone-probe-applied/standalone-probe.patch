+                for offset in [0.15, 0.85, 1.75, 2.85, 3.75, 6.85, 7.75] {
+                    try await sleepUntil(start + offset)
+                    recorder.standaloneSnapshot("standalone-snapshot-\(index)-\(offset)")
+                }
+            }
