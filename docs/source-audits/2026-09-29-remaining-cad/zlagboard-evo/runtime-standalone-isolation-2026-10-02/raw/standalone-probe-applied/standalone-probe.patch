+                guard ProcessInfo.processInfo.systemUptime < readyDeadline else {
+                    recorder.harnessEvent("standalone-readiness-timeout", state: selection.rawValue,
+                                          viewport: viewport)
+                    return
+                }
+                try await Task.sleep(for: .milliseconds(100))
