+    /// Existing deep-link callback only; no body logging or navigation mutation.
+    func trainNavigation(stage: String, boardID: String, planID: String,
+                         presentationCount: Int, showsWorkout: Bool,
+                         clearSlotRequested: Bool) {
+        guard Self.boardDetachTrial else { return }
+        let env = ProcessInfo.processInfo.environment
+        emit(["event": "train-navigation-source", "stage": stage,
+            "boardID": boardID, "planID": planID,
+            "presentationCount": presentationCount,
+            "showsDeepLinkedWorkout": showsWorkout,
+            "sourceBranchRequested": clearSlotRequested ? "clear-slot" : "board-map",
+            "unmountTrainForWorkoutRequested": env["HANGTEN_REVIEW_UNMOUNT_TRAIN_FOR_WORKOUT"] == "1",
+            "initialTrainSuppressionRequested": env["HANGTEN_REVIEW_SUPPRESS_TRAIN_BOARD_HOST"] == "1",
+            "detachRequested": Self.detachesTrainHost,
+            "trialHosts": trialHostSnapshot()])
+    }
+
     /// Once per native board scene init, before its asynchronous USDZ load.
     func boardSceneConstructed(scene: BoardModelRealityScene) {
         guard enabled else { return }
