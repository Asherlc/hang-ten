+#if DEBUG
+@MainActor
+private func traceBoardHighlight(stage: String, model: BoardModelRealityScene,
+                                 boardName: String, ids: Set<String>,
+                                 mode: BoardHighlightMode, size: CGSize?) {
+    guard ProcessInfo.processInfo.environment["HANGTEN_REVIEW_HIGHLIGHT_TRACE"] == "1" else { return }
+    let colors = ids.sorted().map { id in
+        let values = (model.contactEntities[id] ?? []).map { entity in
+            guard let material = entity.model?.materials.first as? PhysicallyBasedMaterial else {
+                return "baseline"
+            }
+            var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0, a: CGFloat = 0
+            material.baseColor.tint.getRed(&r, green: &g, blue: &b, alpha: &a)
+            return "\(r),\(g),\(b),\(a)"
+        }
+        return "\(id)=\(values)"
+    }
+    print("[BoardHighlightTrace] t=\(ProcessInfo.processInfo.systemUptime) stage=\(stage) board=\(boardName) scene=\(ObjectIdentifier(model)) mode=\(mode) ids=\(ids.sorted()) size=\(String(describing: size)) colors=\(colors)")
+}
+#endif
