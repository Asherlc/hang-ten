+    @MainActor
+    func testHostedModelUpdatesHighlightModeWithoutChangingContactsOrLayout() async throws {
+        let scene = try await woodFixtureScene()
+        let contactID = try XCTUnwrap(scene.contactEntities.keys.sorted().first)
+        let entities = try XCTUnwrap(scene.contactEntities[contactID])
+        let state = HostedBoardHighlightState()
+        let host = UIHostingController(rootView: HostedBoardHighlightView(
+            scene: scene, contactID: contactID, state: state))
+        let windowScene = try XCTUnwrap(UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }.first)
+        let previousKeyWindow = windowScene.windows.first(where: \.isKeyWindow)
+        let window = UIWindow(windowScene: windowScene)
+        window.rootViewController = host
+        window.makeKeyAndVisible()
+        defer {
+            window.isHidden = true
+            window.rootViewController = nil
+            previousKeyWindow?.makeKey()
+        }
+
+        // Only SwiftUI drives the scene: calling scene.highlight here would
+        // bypass the retained RealityView update that this regression covers.
+        guard await waitForHighlightTint(.holdActive, on: entities) else {
+            return XCTFail("Hosted model did not render the initial active highlight")
+        }
+        let cameraTransform = scene.camera.transform.matrix
+        state.mode = .preview
+        guard await waitForHighlightTint(.restBlue, on: entities) else {
+            return XCTFail("Changing only mode must replace active red with preview blue")
+        }
+        XCTAssertEqual(scene.camera.transform.matrix, cameraTransform)
+        state.mode = .active
+        let restoredActive = await waitForHighlightTint(.holdActive, on: entities)
+        XCTAssertTrue(restoredActive,
+                      "Returning to active must restore red on the same contacts")
+        XCTAssertEqual(scene.camera.transform.matrix, cameraTransform)
+        for entity in entities {
+            XCTAssertEqual(scene.contactID(for: entity), contactID)
+            XCTAssertNotNil(entity.collision)
+        }
+        for (otherID, otherEntities) in scene.contactEntities where otherID != contactID {
+            for entity in otherEntities {
+                XCTAssertTrue(entity.model?.materials.first is CustomMaterial)
+            }
+        }
+    }
