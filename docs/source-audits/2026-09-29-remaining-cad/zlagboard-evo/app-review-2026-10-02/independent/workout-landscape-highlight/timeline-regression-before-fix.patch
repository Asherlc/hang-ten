+@MainActor
+private final class HostedBoardHighlightState: ObservableObject {
+    @Published var mode: BoardHighlightMode = .active
+}
+
+private struct HostedBoardHighlightView: View {
+    let scene: BoardModelRealityScene
+    let contactID: String
+    @ObservedObject var state: HostedBoardHighlightState
+
+    var body: some View {
+        BoardModelRealityView(
+            model: scene, boardName: "Highlight regression", accessibilityValue: nil,
+            contacts: [], positionID: nil, highlightedContactIDs: [contactID],
+            highlightMode: state.mode, onContactTap: nil, onUnavailable: nil)
+            .frame(width: 500, height: 160)
+    }
+}
+
+@MainActor
+private final class HostedTimelineHighlightProbe {
+    // Deliberately not observable: the real workout derives its mode from a
+    // TimelineView tick, not an observable property read by RealityView.
+    var mode: BoardHighlightMode?
+}
+
+private struct HostedTimelineHighlightView: View {
+    let scene: BoardModelRealityScene
+    let contactID: String
+    let start: Date
+    let probe: HostedTimelineHighlightProbe
+
+    var body: some View {
+        GeometryReader { _ in
+            TimelineView(.periodic(from: start, by: 0.25)) { context in
+                let elapsed = context.date.timeIntervalSince(start)
+                let mode: BoardHighlightMode = elapsed >= 3 && elapsed < 6 ? .preview : .active
+                VStack {
+                    Text(mode == .preview ? "Next hold preview" : "Active")
+                        .frame(height: 24)
+                    BoardModelRealityView(
+                        model: scene, boardName: "Timeline regression", accessibilityValue: nil,
+                        contacts: [], positionID: nil, highlightedContactIDs: [contactID],
+                        highlightMode: mode, onContactTap: nil, onUnavailable: nil)
+                        .frame(width: 500, height: 160)
+                }
+                .onChange(of: mode, initial: true) { _, mode in probe.mode = mode }
+            }
+        }
+    }
+}
