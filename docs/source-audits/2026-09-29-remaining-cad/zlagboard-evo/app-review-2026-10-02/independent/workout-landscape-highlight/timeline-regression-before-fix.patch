+    @MainActor
+    func testTimelineDrivenHostedModelUpdatesHighlightModeWithoutLayoutChanges() async throws {
+        let scene = try await woodFixtureScene()
+        let contactID = try XCTUnwrap(scene.contactEntities.keys.sorted().first)
+        let entities = try XCTUnwrap(scene.contactEntities[contactID])
+        let probe = HostedTimelineHighlightProbe()
+        let host = UIHostingController(rootView: HostedTimelineHighlightView(
+            scene: scene, contactID: contactID, start: .now, probe: probe))
+        let windowScene = try XCTUnwrap(UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }.first)
+        let previousKeyWindow = windowScene.windows.first(where: \.isKeyWindow)
+        let window = UIWindow(windowScene: windowScene)
+        window.rootViewController = host
+        window.makeKeyAndVisible()
+        defer {
+            window.isHidden = true
+            window.rootViewController = nil
+            previousKeyWindow?.makeKey()
+        }
+        guard await waitForHighlightTint(.holdActive, on: entities) else {
+            return XCTFail("Timeline model did not render the initial active highlight")
+        }
+        let cameraTransform = scene.camera.transform.matrix
+        let enteredPreview = await waitForTimelineMode(.preview, probe: probe)
+        XCTAssertTrue(enteredPreview, "The parent timeline must reach preview before checking the material")
+        guard await waitForHighlightTint(.restBlue, on: entities) else {
+            return XCTFail("Timeline changed to preview but the retained model stayed active red")
+        }
+        XCTAssertEqual(scene.camera.transform.matrix, cameraTransform)
+        let returnedToActive = await waitForTimelineMode(.active, probe: probe)
+        XCTAssertTrue(returnedToActive)
+        let restoredActive = await waitForHighlightTint(.holdActive, on: entities)
+        XCTAssertTrue(restoredActive)
+        XCTAssertEqual(scene.camera.transform.matrix, cameraTransform)
+    }
+
+    @MainActor
+    private func waitForTimelineMode(_ mode: BoardHighlightMode,
+                                     probe: HostedTimelineHighlightProbe) async -> Bool {
+        for _ in 0..<100 {
+            if probe.mode == mode { return true }
+            try? await Task.sleep(for: .milliseconds(50))
+        }
+        return false
+    }
+
+    @MainActor
+    private func waitForHighlightTint(_ color: Color, on entities: [ModelEntity]) async -> Bool {
+        let expected = UIColor(color).withAlphaComponent(0.6)
+        func components(_ color: UIColor) -> [CGFloat]? {
+            var red: CGFloat = 0, green: CGFloat = 0, blue: CGFloat = 0, alpha: CGFloat = 0
+            guard color.getRed(&red, green: &green, blue: &blue, alpha: &alpha) else { return nil }
+            return [red, green, blue, alpha]
+        }
+        guard let expectedComponents = components(expected) else { return false }
+        for _ in 0..<100 {
+            let matches = !entities.isEmpty && entities.allSatisfy { entity in
+                guard let material = entity.model?.materials.first as? PhysicallyBasedMaterial,
+                      let actual = components(material.baseColor.tint) else { return false }
+                return zip(actual, expectedComponents).allSatisfy { abs($0.0 - $0.1) < 0.001 }
+            }
+            if matches { return true }
+            try? await Task.sleep(for: .milliseconds(50))
+        }
+        return false
+    }
