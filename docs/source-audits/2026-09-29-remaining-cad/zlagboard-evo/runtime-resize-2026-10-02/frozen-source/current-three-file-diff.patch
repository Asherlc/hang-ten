+    }
+
+    private func runScript() async {
+        let recorder = BoardHighlightDiagnostic.shared
+        guard ["A", "B", "C", "D", "E", "F", "G"].contains(driver),
+              env["HANGTEN_REVIEW_SCENE_UPDATE_COUNTER"] != "1" else {
