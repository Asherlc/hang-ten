+                        "lastSwiftUIEvent": observation.lastSwiftUIEvent,
+                        "lastSwiftUIEventSequence": observation.lastSwiftUIEventSequence.map { $0 as Any } ?? NSNull(),
+                        "lastSwiftUIEventUptime": observation.lastSwiftUIEventUptime.map { $0 as Any } ?? NSNull()]
+                }
+            return ["handLifetimeToken": token.uuidString, "kind": record.kind,
+                "constructedRootID": record.constructedRootID,
+                "constructedCameraID": record.constructedCameraID,
+                "configuredObserved": record.configuredObserved,
