+                "perspectiveComponent": value.components[PerspectiveCameraComponent.self] != nil]
+        }
+        return handLifetimes.keys.sorted { $0.uuidString < $1.uuidString }.map { token in
+            let record = handLifetimes[token]!
+            let views: [[String: Any]] = handViews.keys.sorted { $0.uuidString < $1.uuidString }
+                .filter { handViews[$0]!.lifetimes.contains(token) }.map { view in
+                    let observation = handViews[view]!
+                    return ["viewToken": view.uuidString,
