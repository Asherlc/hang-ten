+    // Offscreen PNGs stay beneath the exact registered diagnostic run directory.
+    func handImageDirectory(session: UUID) throws -> URL {
+        guard enabled, !failed,
+              ProcessInfo.processInfo.environment["HANGTEN_REVIEW_HAND_IMAGE"] == "1",
+              let diagnosticArtifactDirectory else { throw CocoaError(.fileWriteUnknown) }
+        let directory = diagnosticArtifactDirectory
+            .appendingPathComponent("hand-image-prototype", isDirectory: true)
+            .appendingPathComponent(session.uuidString, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
