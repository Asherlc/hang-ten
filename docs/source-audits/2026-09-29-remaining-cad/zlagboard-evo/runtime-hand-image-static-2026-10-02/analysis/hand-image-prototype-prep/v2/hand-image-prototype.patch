+    // Sparse, launch-gated offscreen-render probe events; no sampler or renderer mutation.
+    func handImage(_ event: String, fields: [String: Any]) {
+        guard Self.isEnabled,
+              ProcessInfo.processInfo.environment["HANGTEN_REVIEW_HAND_IMAGE"] == "1" else { return }
+        var value = fields
+        value["event"] = "hand-image"
+        value["imageEvent"] = event
+        if event == "published" { value["applicationCensus"] = applicationCensus() }
+        emit(value)
