+        guard samplers[key] == nil else { return }
+        samplers[key] = Task { @MainActor [weak scene] in
+            for _ in 0..<120 {
+                do { try await Task.sleep(for: .seconds(1)) }
+                catch { return }
+                guard !Task.isCancelled, let scene else { return }
