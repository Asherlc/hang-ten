+    // Application-side call/assignment counts, including repeated equal values.
+    // A nonnil component setter does not prove a render commit or displayed frame.
+    enum SyncMetric: String, CaseIterable {
+        case realityMakeEntries, realityUpdateEntries, applySyncEntries, applySyncCompletions
+        case cameraComponentWrites, frameCalls
+        case cameraTransformEntries, cameraPositionWrites, cameraLookAtWrites
+        case highlightEntries, unchangedHighlightRequests, highlightUpdatePasses
+        case baselineMaterialWrites, clearMaterialWrites, highlightMaterialWrites
+    }
+    private var syncSceneCounts: [UUID: [String: Int]] = [:]
+    private var syncViewCounts: [ViewSceneKey: [String: Int]] = [:]
+    private var syncSceneFirstUptime: [UUID: [String: Double]] = [:]
+    private var syncSceneLatestUptime: [UUID: [String: Double]] = [:]
+    private var syncViewFirstUptime: [ViewSceneKey: [String: Double]] = [:]
+    private var syncViewLatestUptime: [ViewSceneKey: [String: Double]] = [:]
+    private var syncContexts: [UUID: [UUID]] = [:]
+    private var syncContextMismatches: [UUID: Int] = [:]
+
+    func countSync(_ metric: SyncMetric, scene: BoardModelRealityScene, view: UUID? = nil) {
+        guard Self.countsSyncDelivery else { return }
+        let sceneID = scene.diagnosticLifecycleToken
+        let uptime = ProcessInfo.processInfo.systemUptime
+        syncSceneCounts[sceneID, default: [:]][metric.rawValue, default: 0] += 1
+        if syncSceneFirstUptime[sceneID]?[metric.rawValue] == nil {
+            syncSceneFirstUptime[sceneID, default: [:]][metric.rawValue] = uptime
+        }
+        syncSceneLatestUptime[sceneID, default: [:]][metric.rawValue] = uptime
+        // Model writes are attributed only to a real synchronous applySync call stack.
+        // Calls outside that scope remain scene-only; never infer the last visible view.
+        if let viewID = view ?? syncContexts[sceneID]?.last {
+            let key = ViewSceneKey(scene: sceneID, view: viewID)
+            syncViewCounts[key, default: [:]][metric.rawValue, default: 0] += 1
+            if syncViewFirstUptime[key]?[metric.rawValue] == nil {
+                syncViewFirstUptime[key, default: [:]][metric.rawValue] = uptime
+            }
+            syncViewLatestUptime[key, default: [:]][metric.rawValue] = uptime
+        }
+    }
+
+    func beginSync(scene: BoardModelRealityScene, view: UUID) {
+        guard Self.countsSyncDelivery else { return }
+        let sceneID = scene.diagnosticLifecycleToken
+        syncContexts[sceneID, default: []].append(view)
+        countSync(.applySyncEntries, scene: scene, view: view)
+    }
+
+    func endSync(scene: BoardModelRealityScene, view: UUID) {
+        guard Self.countsSyncDelivery else { return }
+        let sceneID = scene.diagnosticLifecycleToken
+        guard syncContexts[sceneID]?.last == view else {
+            syncContextMismatches[sceneID, default: 0] += 1
+            return
+        }
+        countSync(.applySyncCompletions, scene: scene, view: view)
+        syncContexts[sceneID]?.removeLast()
+    }
+
+    private func syncCounterSnapshot(sceneID: UUID) -> [String: Any] {
+        func filled(_ values: [String: Int]) -> [String: Int] {
+            Dictionary(uniqueKeysWithValues: SyncMetric.allCases.map { ($0.rawValue, values[$0.rawValue] ?? 0) })
+        }
+        let viewRows: [[String: Any]] = syncViewCounts.keys.filter { $0.scene == sceneID }
+            .sorted { $0.view.uuidString < $1.view.uuidString }.map { key in
+                ["viewToken": key.view.uuidString, "counts": filled(syncViewCounts[key] ?? [:]),
+                 "firstUptime": syncViewFirstUptime[key] ?? [:],
+                 "latestUptime": syncViewLatestUptime[key] ?? [:]]
+            }
+        return ["version": 2, "sceneToken": sceneID.uuidString,
+                "sceneTotals": filled(syncSceneCounts[sceneID] ?? [:]), "views": viewRows,
+                "firstUptime": syncSceneFirstUptime[sceneID] ?? [:],
+                "latestUptime": syncSceneLatestUptime[sceneID] ?? [:],
+                "semanticRevision": syncSceneCounts[sceneID]?[SyncMetric.highlightUpdatePasses.rawValue] ?? 0,
+                "synchronousScopeDepth": syncContexts[sceneID]?.count ?? 0,
+                "scopeMismatches": syncContextMismatches[sceneID] ?? 0]
+    }
