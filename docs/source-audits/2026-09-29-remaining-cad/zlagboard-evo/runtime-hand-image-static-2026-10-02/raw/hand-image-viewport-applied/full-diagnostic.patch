+    static let recordsStartupObservation = isEnabled
+        && ProcessInfo.processInfo.environment["HANGTEN_REVIEW_STARTUP_OBSERVATION"] == "1"
+
+    // Scalar diagnostic association only; never retain coach, task, view, or scene.
+    private var startupAppearances: [String: Int] = [:]
+    private var startupAmbiguous: Set<String> = []
+    private var startupScopes: [String: [String]] = [:]
+    private var startupParents: [String: String] = [:]
+    private var startupPending: [String: String] = [:]
+    private var startupArmed: [String: String] = [:]
+
+    func startupContextAppeared(_ context: String) {
+        guard Self.recordsStartupObservation else { return }
+        startupAppearances[context, default: 0] += 1
+        if startupAppearances[context] != 1 || startupAppearances.count != 1 {
+            startupAssociationIssue(context, reason: "multiple-workout-appearances-or-contexts")
+        }
+        startupObservation("startup-context-appear", fields: ["contextID": context,
+            "appearanceCount": startupAppearances[context] ?? 0])
+    }
+    private func startupAssociationIssue(_ context: String, reason: String) {
+        startupAmbiguous.insert(context)
+        startupObservation("startup-association-ambiguous", fields: ["contextID": context, "reason": reason])
+    }
+    func startupAssociationValid(_ context: String) -> Bool {
+        startupAppearances[context] == 1 && startupAppearances.count == 1 && !startupAmbiguous.contains(context)
+    }
+    func startupCurrentAttempt(_ context: String) -> String? { startupScopes[context]?.last }
+    func startupParentAttempt(_ attempt: String) -> String? { startupParents[attempt] }
+    func startupBeginRequest(_ context: String) -> String? {
+        guard Self.recordsStartupObservation else { return nil }
+        let attempt = UUID().uuidString
+        if let pending = startupPending[context], startupCurrentAttempt(context) != pending {
+            startupAssociationIssue(context, reason: "request-overlaps-unconsumed-deferred-request")
+        }
+        if let parent = startupCurrentAttempt(context) { startupParents[attempt] = parent }
+        startupPushAttempt(context, attempt: attempt)
+        return attempt
+    }
+    func startupPushAttempt(_ context: String, attempt: String?) {
+        guard Self.recordsStartupObservation, let attempt else { return }
+        startupScopes[context, default: []].append(attempt)
+    }
+    func startupPopAttempt(_ context: String, attempt: String?) {
+        guard Self.recordsStartupObservation, let attempt else { return }
+        guard startupScopes[context]?.last == attempt else {
+            startupAssociationIssue(context, reason: "synchronous-attempt-scope-mismatch"); return
+        }
+        startupScopes[context]?.removeLast()
+    }
+    func startupDeferRequest(_ context: String, attempt: String?) {
+        guard Self.recordsStartupObservation, let attempt else { return }
+        if let old = startupPending[context], old != attempt {
+            startupAssociationIssue(context, reason: "deferred-request-overwrite")
+        }
+        startupPending[context] = attempt
+    }
+    func startupTakeDeferred(_ context: String) -> String? {
+        guard Self.recordsStartupObservation else { return nil }
+        let attempt = startupPending.removeValue(forKey: context)
+        guard let attempt, startupAssociationValid(context) else {
+            startupAssociationIssue(context, reason: "missing-or-ambiguous-deferred-association"); return nil
+        }
+        return attempt
+    }
+    func startupArmRequest(_ context: String, attempt: String?) {
+        guard Self.recordsStartupObservation, let attempt else { return }
+        if startupArmed[context] != nil { startupAssociationIssue(context, reason: "armed-request-overwrite") }
+        startupArmed[context] = attempt
+    }
+    func startupArmCompleted(_ context: String, attempt: String?) {
+        guard Self.recordsStartupObservation, let attempt else { return }
+        guard startupArmed[context] == attempt else {
+            startupAssociationIssue(context, reason: "old-task-completed-after-arm-association-changed"); return
+        }
+        startupArmed.removeValue(forKey: context)
+    }
+    func startupCancellationRequested(_ context: String, taskPresent: Bool, pendingPresent: Bool, site: String) {
+        guard Self.recordsStartupObservation else { return }
+        if (taskPresent && startupArmed[context] == nil) || (pendingPresent && startupPending[context] == nil) {
+            startupAssociationIssue(context, reason: "cancellation-target-association-missing")
+        }
+        startupObservation("startup-cancellation-requested", fields: ["contextID": context,
+            "site": site, "taskPresent": taskPresent, "pendingPresent": pendingPresent,
+            "armedAttemptID": startupArmed[context].map { $0 as Any } ?? NSNull(),
+            "deferredAttemptID": startupPending[context].map { $0 as Any } ?? NSNull(),
+            "associationValid": startupAssociationValid(context)])
+        startupArmed.removeValue(forKey: context)
+        startupPending.removeValue(forKey: context)
+    }
+
+    // Scalar-only startup markers: no UIKit census, entity access, or new scheduling.
+    func startupObservation(_ event: String, fields: [String: Any]) {
+        guard Self.recordsStartupObservation else { return }
+        var row = fields
+        row["event"] = event
+        emit(row)
+    }
