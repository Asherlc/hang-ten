  "conflicts": [
    {
      "issue": "Manufacturer dimension axes not explicit",
      "ruling": "Interpret 12.75 inches as per-half width and 5.25 as height from the front aspect and individual-half listing. Thickness remains estimated."
    },
    {
      "issue": "Photo shows five openings per half; manual supplies four screws per half",
      "ruling": "Retain all five observed openings per half. Classify four small openings as mounting holes and the larger IMR opening as an observed passage with unresolved purpose; do not call it a hold or cord attachment."
    },
    {
      "issue": "Pinch/IMR grip labels overlap physically",
      "ruling": "Keep one IMR contact per half; medium/narrow pinch patches are reused in a wide-pinch interaction group. Do not clone the IM/IMR surfaces."
    }
  ],
  "limitations": [
    "Per-half depth and sculpted sections are photo-derived estimates; the published two dimensions do not identify axes explicitly.",
    "Outer pinch widths and sloper transitions are approximate sculpted reconstructions, not calibrated CAD.",
    "Hidden rear surface is simplified. Pinch grip combinations reference existing surfaces and do not create duplicate geometry."
  ],
