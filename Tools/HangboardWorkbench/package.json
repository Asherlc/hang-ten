{
  "name": "hangboard-workbench-ui",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --format=iife --platform=browser --target=es2020 --outfile=app.js",
    "typecheck": "tsc --noEmit",
    "test:modules": "tsx --test tests/path-editor.test.ts tests/workbench-modules.test.ts",
    "test:react": "tsx --test tests/react-app.test.tsx",
    "test": "npm run typecheck && npm run test:modules && npm run test:react",
    "check:bundle": "npm run build && git diff --exit-code -- app.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
